# Copy to backend/backend/.env and adjust as needed

# Comma-separated origins allowed to call the API (the Vite dev server by default)
FRONTEND_ORIGINS=http://localhost:5173

# Port 5000 clashes with AirPlay Receiver on macOS
PORT=5001

# Set to 1 only for local development, never on a shared machine
FLASK_DEBUG=0

# Rate limits per client IP and across all clients (Flask-Limiter syntax)
RATE_LIMIT_SONG=20 per minute
RATE_LIMIT_SONG_GLOBAL=100 per minute
RATE_LIMIT_PREVIEW=60 per minute
RATE_LIMIT_PREVIEW_GLOBAL=200 per minute

# Where rate limit counters live; use redis://host:6379 to share them across processes
RATELIMIT_STORAGE_URI=memory://

# Set to the number of reverse proxies (e.g. 1 behind nginx) so the real client IP is used
TRUSTED_PROXIES=0

# Production server (gunicorn) settings
HOST=127.0.0.1
WEB_WORKERS=1
WEB_THREADS=8
